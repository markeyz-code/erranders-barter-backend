# ============================================
# Barter Backend Environment Configuration
# ============================================

# Server
PORT=3005
NODE_ENV=production

# MongoDB Atlas
MONGODB_URI=mongodb+srv://barter_user:CHANGE_ME@cluster0.xxxxx.mongodb.net/barter-prod?retryWrites=true&w=majority

# JWT Auth
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING
JWT_EXPIRES_IN=7d

# Admin bootstrap. The /admin/* routes require a user whose isAdmin flag is true.
# Comma-separated emails listed here are also accepted as admins, which lets an owner
# grant the first admin without editing MongoDB. Leave empty to rely on isAdmin only.
# The Barter seed marks admin@barter.test as an admin.
ADMIN_EMAILS=

# Frontend URL (used to build the password-reset link)
FRONTEND_URL=http://localhost:3000
APP_NAME=Erranders Barter

# Transactional email (Resend SDK / API)
RESEND_API_KEY=re_en2j38YZ_...
EMAIL_FROM="Erranders Declutter <notifications@decluttered.erranders.org>"
EMAIL_API_URL=https://api.resend.com/emails
EMAIL_API_KEY=


# Cloudinary
CLOUDINARY_CLOUD_NAME=CHANGE_ME
CLOUDINARY_API_KEY=CHANGE_ME
CLOUDINARY_API_SECRET=CHANGE_ME

# Erranders logistics integration (no placeholder keys are used)
# The Erranders marketplace API. Used to check whether a business slug is already a
# vendor shop, since both share <slug>.erranders.org. Leave blank to skip the check.
ERRANDERS_API_URL=
BARTER_API_KEY=

# Paystack payouts (wallet withdrawals). Use Barter's own Paystack account: payouts are
# transferred from this account's Paystack balance. A test key (sk_test_...) still calls
# the real Paystack test API — there is no mock/simulated payout mode.
PAYSTACK_SECRET_KEY=

# Evolution API (WhatsApp)
WHATSAPP_PROVIDER=evolution
WHATSAPP_EVOLUTION_API_URL=https://evolution-api-production-038c.up.railway.app
WHATSAPP_EVOLUTION_API_KEY=your_evolution_api_key_here
WHATSAPP_EVOLUTION_INSTANCE=ojaly
CUSTOMER_SERVICE_WHATSAPP="+2348106600919"
